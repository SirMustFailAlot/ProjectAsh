{
    "schemaVersion": 1,
    "id": "project_ash",
    "version": "${version}",
  
    "name": "ProjectAsh",
    "description": "ProjectAsh aims to announce everything, everywhere. Ingame? Sure! Discord? Heck Yeah buddy!",
    "icon": "ProjectAsh-Square.jpg",
    "authors": [
      "sirmustfailalot"
    ],
    "contact": {
      "homepage": "",
      "sources": "https://github.com/SirMustFailAlot/ProjectAsh"
    },
  
    "license": "CC0-1.0",
  
    "environment": "*",
    "entrypoints": {
      "main": [
        {
          "adapter": "kotlin",
          "value": "io.github.sirmustfailalot.projectash.fabric.ProjectAshFabric"
        }
      ],
      "client": [
        {
          "adapter": "kotlin",
          "value": "io.github.sirmustfailalot.projectash.fabric.ProjectAshFabricClient"
        }
      ]
    },
    "mixins": [
      "projectash.mixins.json"
    ],
  
    "depends": {
      "fabricloader": "*",
      "fabric": "*",
      "minecraft": "1.21.1",
      "java": ">=21",
